NODE_ENV=development
PORT=3000

# Google Gemini AI (for signal validation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Telegram Bot (for signal alerts)
# 1. Create bot via @BotFather → get token
# 2. Add bot as Admin to your channel
# 3. Get channel ID (use @userinfobot for private channels)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=@yourchannel_or_-1001234567890

# Frontend config (Vite)
# Dev: full URL. Production: leave empty (Express serves frontend)
VITE_SOCKET_URL=http://localhost:3000
VITE_RESCAN_INTERVAL=60000
VITE_MIN_ALERT_SCORE=75
